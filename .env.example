# 212 Café — local environment
# The anon/publishable key is PUBLIC by design: it ships to every phone that scans a QR
# code. All protection comes from RLS + the place_order SECURITY DEFINER function, both
# verified by tests/security.test.mjs. No service-role key is needed anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Absolute origin used for QR codes, canonical URLs and JSON-LD.
# Set this to the deployed URL before printing any QR codes.
NEXT_PUBLIC_SITE_URL=https://212-demo.vercel.app

# Walk-in / online ordering (migration 0012): token for the "Online" cafe_tables row.
# Lets guests order from the shopfront and menu without scanning a table QR.
# Read it from the DB after applying 0012. Unset, ordering stays QR-only.
WALK_IN_TABLE_TOKEN=
